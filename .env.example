# Copy to backend/.env (non-Docker) or .env (Docker Compose). No secrets are required for the demo.
# SQLite development fallback (NOT PostgreSQL). Default if unset:
FPI_DATABASE_URL=sqlite:///./fpi_dev.db
# PostgreSQL (used by docker-compose):
# FPI_DATABASE_URL=postgresql+psycopg://fpi:CHANGE_ME@db:5432/fpi
FPI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FPI_CURRENCY=INR
FPI_MAX_UPLOAD_MB=5
FPI_LOG_LEVEL=INFO
FPI_SEED=42
FPI_DEMO_DAYS=90
FPI_SIM_AUTOSTART=false
# Loss-model assumptions (see docs/ANALYTICS_METHODOLOGY.md)
FPI_DOWNTIME_UNRECOVERABLE_SHARE=0.70
FPI_SCRAP_SALVAGE_RATE=0.10
FPI_REALIZATION_FACTOR=0.50
# docker-compose only
POSTGRES_PASSWORD=CHANGE_ME
